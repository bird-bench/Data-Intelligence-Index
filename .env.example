# Copy to .env and fill in the keys you need. Keys are passed to Harbor only, never written to job files.
# Interact (simulated user) and Workspace (judge) tasks call OpenAI with this key, whatever model you test.
OPENAI_API_KEY=
# The model under test, depending on its provider:
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional endpoint override, e.g. a compatible gateway:
# OPENAI_BASE_URL=https://api.openai.com/v1
